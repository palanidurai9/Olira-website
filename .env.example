# ==============================================================================
# OLIRAA ("Modesty Made Modern") - Environment Configuration Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite Client Variables - Accessible in browser)
# ------------------------------------------------------------------------------
# Copy this file to `.env` in the root directory for local development.

# Firebase Web App Configuration
# Obtain from Firebase Console > Project Settings > General > Your Apps (Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Razorpay Client-Side Key ID (Public key only - SAFE for browser)
# Obtain from Razorpay Dashboard > Settings > API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Optional: Custom Cloud Functions Region (Defaults to asia-south1 if unset)
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE & CLOUD FUNCTIONS SECRETS (DO NOT EXPOSE IN CLIENT BUNDLE!)
# ------------------------------------------------------------------------------
# These secrets must ONLY be set in Firebase Cloud Functions configuration or
# in functions/.env for local Cloud Functions emulation.
# Use: firebase functions:secrets:set SECRET_NAME
# ------------------------------------------------------------------------------

# Razorpay Secret Key (CRITICAL: Used ONLY by Cloud Functions to create orders and verify HMAC signatures)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Shiprocket API Credentials (Used ONLY by Cloud Functions to create shipments and fetch tracking)
# Obtain from Shiprocket Dashboard > API > Configure
SHIPROCKET_EMAIL=your_shiprocket_account_email@domain.com
SHIPROCKET_PASSWORD=your_shiprocket_account_password

# Resend Email Service API Key (Used ONLY by Cloud Functions for automated order/shipping emails)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=orders@oliraa.com
